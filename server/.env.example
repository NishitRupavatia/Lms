# MongoDB connection string WITHOUT a database name — the app appends "/lms"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Clerk (https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Only needed if you configure the Clerk webhook. Not required on localhost:
# users are synced from the Clerk session on first API call instead.
CLERK_WEBHOOK_SECRET=whsec_xxx

# Cloudinary (course thumbnails)
CLOUDINARY_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_SECRET_KEY=xxx

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Only needed if you forward Stripe webhooks (e.g. with the Stripe CLI).
# On localhost the browser return trip completes the enrollment instead.
STRIPE_WEBHOOK_SECRET=whsec_xxx

CURRENCY=INR
PORT=5000
